# Example environment configuration for local development with docker-compose
# Copy this file to .env and fill in your actual values

# Secret key for encryption (must be at least 32 bytes when hex-decoded)
# Generate with: openssl rand -hex 32
APP_SECRET=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# Redis Configuration
# When using docker-compose, this is automatically set to the redis service
# For production, use your actual Redis URL (e.g., Upstash)
# UPSTASH_REDIS_URL is set automatically in docker-compose.yml

# Optional: Debug Settings
# Set to "true" to save every intervals.icu response body to .request-debug-*.log
DEBUG_INTERVALS_RESPONSE_BODY=false

# Optional: periodic sync of connected athletes (defaults shown)
# SYNC_INTERVAL_MINUTES=15
# SYNC_WINDOW_DAYS=30

# Optional: intervals.icu request budgets, used until responses report the limits (defaults shown)
# INTERVALS_RATE_LIMIT_15MIN=6250
# INTERVALS_RATE_LIMIT_DAILY=50000

# intervals.icu API keys are per athlete: each one enters theirs on the /connect page.

# S3-compatible blob storage credentials (bucket and endpoint are in skintrackr/config.py)
AWS_ACCESS_KEY_ID=your_access_key_id
AWS_SECRET_ACCESS_KEY=your_secret_access_key

# Frontend: MapTiler key for the 3D map (public, inlined into the JS bundle; restrict it to your domains)
# Get one at https://cloud.maptiler.com/account/keys/
VITE_MAPTILER_KEY=
